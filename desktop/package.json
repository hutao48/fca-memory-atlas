{
  "name": "@fca/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "FCA Memory Atlas — Windows desktop shell (Electron 38): three-pane professional astronomy UI, local Runtime lifecycle management, WebGL2 nebula canvas.",
  "main": "main/main.js",
  "author": "FCA Project",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "set \"ELECTRON_RUN_AS_NODE=\" && \"..\\.cache\\electron-dist\\electron.exe\" .",
    "start:dev": "set \"ELECTRON_RUN_AS_NODE=\" && \"..\\.cache\\electron-dist\\electron.exe\" . --dev",
    "capture": "set \"ELECTRON_RUN_AS_NODE=\" && \"..\\.cache\\electron-dist\\electron.exe\" main\\capture.js",
    "capture:matrix": "set \"ELECTRON_RUN_AS_NODE=\" && \"..\\.cache\\electron-dist\\electron.exe\" main\\capture.js --preset=full",
    "lint": "node --check main/main.js"
  },
  "files": [
    "main/**/*",
    "renderer/**/*",
    "package.json"
  ],
  "engines": {
    "node": ">=24.0.0"
  }
}
